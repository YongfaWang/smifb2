# Normalise line endings for shell scripts so they remain executable on
# Linux.  Without this a checkout on Windows would produce CRLF files and
# the kernel would refuse to run them ("bad interpreter: /bin/bash^M").
*.sh text eol=lf
*.conf text eol=lf
Makefile text eol=lf
Makefile.kernel text eol=lf
Kconfig text eol=lf

# sha256sum -c on the target machine must see plain LF lines.
SHA256SUMS text eol=lf
*.md text eol=lf
